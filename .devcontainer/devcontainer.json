{
  "name": "gh-x",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.26-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "go mod download && bash .github/scripts/install-quality-tools.sh all",

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "go.lintTool": "staticcheck",
        "go.testFlags": ["-race", "-count=1"],
        "go.coverOnSave": true
      }
    }
  }
}
